# --- Dependencies ---
node_modules/

# --- Next.js build output ---
.next/
out/
next-env.d.ts

# --- TypeScript ---
*.tsbuildinfo

# --- Rust build output ---
# Only the compiled engine is committed: public/engine.wasm (Vercel has no Rust).
# rsa-engine/Cargo.lock is committed too, on purpose.
rsa-engine/target/

# --- Tests ---
coverage/

# --- Environment variables and secrets ---
.env
.env.*
!.env.example

# --- Vercel local link (holds project and org ids) ---
.vercel/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Editors ---
.vscode/
.idea/
*.swp
*~

# --- OS files ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Claude Code local state (preview config, scratch workspace) ---
.claude/
.superpowers/

# --- Temporary files ---
*.tmp
